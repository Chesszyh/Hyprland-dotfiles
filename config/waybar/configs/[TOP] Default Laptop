// ### DEFAULT Laptop  - Top ### //
{
"include": [
  "$HOME/.config/waybar/Modules",
  "$HOME/.config/waybar/ModulesWorkspaces",
  "$HOME/.config/waybar/ModulesCustom",
  "$HOME/.config/waybar/ModulesGroups",
  "$HOME/.config/waybar/UserModules",
  "$HOME/.config/hypr/configs/waybar-minimized.jsonc",
  ],
"layer": "top",
"exclusive": true,
"passthrough": false,
"position": "top",
"spacing": 3,
"fixed-center": true,
"ipc": true,
"margin-top": 0,
"margin-left": 0,
"margin-right": 0,

"modules-left": [
	"custom/separator#blank",
	"custom/cava_mviz",
	"custom/separator#blank",
	"custom/playerctl",
	"custom/separator#blank_2",
	"hyprland/window",
	],

"modules-center": [
	"custom/light_dark",
	"group/notify",
	"custom/separator#dot-line",
	"hyprland/workspaces#rw",
	"custom/minimized",
	"clock",
	"custom/separator#dot-line",
	"custom/weather",
	"custom/separator#dot-line",
	"custom/hypridle",
	"custom/hint",	
	],

"modules-right": [
	"custom/codexbar",
	"custom/separator#dot-line",
	"tray",
	"network#speed",
	"custom/separator#dot-line",
	"group/laptop",
	"custom/separator#dot-line",
	"group/mobo_drawer",
	"custom/separator#line",  
	"group/audio",
	"custom/separator#dot-line", 
	"group/status",
	],
}
