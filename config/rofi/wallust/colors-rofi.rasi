 /* wallust template - colors-rofi */

* {
active-background: #8B8BA6;
active-foreground: #F6EFF4;
normal-background: #00000C;
normal-foreground: #F6EFF4;
urgent-background: #DBCAD9;
urgent-foreground: #F6EFF4;

alternate-active-background: #8787A9;
alternate-active-foreground: #F6EFF4;
alternate-normal-background: #00000C;
alternate-normal-foreground: #F6EFF4;
alternate-urgent-background: #00000C;
alternate-urgent-foreground: #F6EFF4;

selected-active-background: #DBCAD9;
selected-active-foreground: #F6EFF4;
selected-normal-background: #DBCAD9;
selected-normal-foreground: #F6EFF4;
selected-urgent-background: #8B8BA6;
selected-urgent-foreground: #F6EFF4;

background-color: #00000C;
background: rgba(0,0,0,0.7);
foreground: #F6EFF4;
border-color: #8B8BA6;

color0: #111219;
color1: #343E5B;
color2: #3B4460;
color3: #65657F;
color4: #68687D;
color5: #A498A3;
color6: #AC9EA7;
color7: #EAE0E7;
color8: #A39DA1;
color9: #45537A;
color10: #4F5B80;
color11: #8787A9;
color12: #8B8BA6;
color13: #DBCAD9;
color14: #E5D2DF;
color15: #EAE0E7;


}

