/**
 * Dark Angel Clipboard Manager - Ashen fallback
 */

* {
    bg:             rgba(23, 16, 19, 0.95);
    surface:        rgba(33, 20, 24, 0.88);
    surface-strong: rgba(43, 23, 29, 0.92);
    border:         rgba(111, 39, 52, 0.78);
    selected-bg:    #d63a4e;
    selected-fg:    #171013;
    blood:          #d63a4e;
    wine:           #7b1d2a;
    bone:           #f0e2e4;
    muted:          #b89399;

    font: "LXGW WenKai 15";
    background-color: transparent;
}

window {
    width:            1000px;
    height:           760px;
    background-color: @bg;
    border:           2px;
    border-color:     @border;
    border-radius:    16px;
}

mainbox {
    padding:          15px;
    spacing:          8px;
    background-color: transparent;
    children:         [ "inputbar", "message", "listview" ];
}

inputbar {
    padding:          12px 16px;
    background-color: @surface-strong;
    border:           1px;
    border-color:     @border;
    border-radius:    12px;
    children:         [ "prompt", "entry" ];
}

prompt {
    text-color:       @blood;
    font:             "LXGW WenKai 18";
    margin:           0px 10px 0px 0px;
}

entry {
    text-color:       @bone;
    placeholder:      "Search Clipboard";
    placeholder-color: @muted;
    background-color: transparent;
}

message {
    padding:          9px 12px;
    background-color: @surface;
    border:           1px;
    border-color:     rgba(111, 39, 52, 0.62);
    border-radius:    10px;
}

textbox {
    text-color:       @muted;
    horizontal-align: 0.5;
    background-color: transparent;
}

listview {
    columns:          1;
    lines:            8;
    spacing:          6px;
    padding:          4px 0px 0px 0px;
    background-color: transparent;
}

element {
    padding:          10px 14px;
    border-radius:    10px;
    background-color: transparent;
    text-color:       @bone;
    spacing:          14px;
    border:           1px;
    border-color:     transparent;
}

element alternate.normal {
    background-color: rgba(33, 20, 24, 0.44);
}

element-icon {
    size:             58px;
    background-color: transparent;
}

element-text {
    text-color:       inherit;
    vertical-align:   0.5;
    background-color: transparent;
}

element selected {
    background-color: @selected-bg;
    text-color:       @selected-fg;
    border-color:     @blood;
}

element selected element-text {
    text-color:       @selected-fg;
    font:             "LXGW WenKai Bold 15";
}
