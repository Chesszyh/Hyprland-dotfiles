/**
 * Dark Angel Clipboard Manager - Abyss
 */

* {
    bg:             rgba(3, 2, 4, 0.95);
    surface:        rgba(13, 3, 6, 0.88);
    surface-strong: rgba(25, 5, 10, 0.92);
    border:         rgba(94, 18, 33, 0.78);
    selected-bg:    rgba(142, 0, 29, 0.65);
    selected-fg:    #f4e7e9;
    blood:          #ff1e3c;
    wine:           #8e001d;
    bone:           #f4e7e9;
    muted:          #a77a81;

    font: "LXGW WenKai 15";
    background-color: transparent;
}

window {
    width:            960px;
    height:           640px;
    background-color: @bg;
    border:           2px;
    border-color:     @border;
    border-radius:    16px;
}

mainbox {
    padding:          15px;
    spacing:          8px;
    background-color: transparent;
    children:         [ "inputbar", "message", "listview" ];
}

inputbar {
    padding:          12px 16px;
    background-color: @surface-strong;
    border:           1px;
    border-color:     @border;
    border-radius:    12px;
    children:         [ "prompt", "entry" ];
}

prompt {
    text-color:       @blood;
    font:             "LXGW WenKai 18";
    margin:           0px 10px 0px 0px;
}

entry {
    text-color:       @bone;
    placeholder:      "Search Clipboard";
    placeholder-color: @muted;
    background-color: transparent;
}

message {
    padding:          9px 12px;
    background-color: @surface;
    border:           1px;
    border-color:     rgba(94, 18, 33, 0.62);
    border-radius:    10px;
}

textbox {
    text-color:       @muted;
    horizontal-align: 0.5;
    background-color: transparent;
}

listview {
    columns:          1;
    lines:            8;
    spacing:          6px;
    padding:          4px 0px 0px 0px;
    background-color: transparent;
}

element {
    padding:          10px 14px;
    border-radius:    10px;
    background-color: transparent;
    text-color:       @bone;
    spacing:          14px;
    border:           1px;
    border-color:     transparent;
}

element alternate.normal {
    background-color: rgba(13, 3, 6, 0.42);
}

element-icon {
    size:             58px;
    background-color: transparent;
}

element-text {
    text-color:       inherit;
    vertical-align:   0.5;
    background-color: transparent;
}

element selected {
    background-color: @selected-bg;
    text-color:       @selected-fg;
    border-color:     @blood;
}

element selected element-text {
    text-color:       @selected-fg;
    font:             "LXGW WenKai Bold 15";
}
